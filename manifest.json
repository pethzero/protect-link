{
  "manifest_version": 3,
  "name": "Protect Link",
  "version": "0.1.0",
  "description": "บล็อกการเด้งไปเว็บอื่นอัตโนมัติ (redirect / pop-up) ที่ผู้ใช้ไม่ได้กดเอง",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "declarativeNetRequest", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared.js", "src/inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Protect Link",
    "default_popup": "src/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/blocked.html", "src/shared.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
